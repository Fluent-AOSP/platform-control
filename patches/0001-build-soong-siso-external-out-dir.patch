+func TestRelativeToSisoExecRoot(t *testing.T) {
+	tests := []struct {
+		name string
+		path string
+	}{
+		{name: "relative output", path: filepath.Join("out", "siso_config")},
+		{name: "absolute external output", path: filepath.Join(t.TempDir(), "siso_config")},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			got, err := relativeToSisoExecRoot(tt.path)
+			if err != nil {
+				t.Fatalf("relativeToSisoExecRoot(%q): %v", tt.path, err)
+			}
+			if filepath.IsAbs(got) {
+				t.Fatalf("relativeToSisoExecRoot(%q) returned absolute path %q", tt.path, got)
+			}
+			gotAbs, err := filepath.Abs(got)
+			if err != nil {
+				t.Fatalf("make returned path absolute: %v", err)
+			}
+			wantAbs, err := filepath.Abs(tt.path)
+			if err != nil {
+				t.Fatalf("make input path absolute: %v", err)
+			}
+			if gotAbs != wantAbs {
+				t.Fatalf("relativeToSisoExecRoot(%q) resolved to %q, want %q", tt.path, gotAbs, wantAbs)
+			}
+		})
+	}
+}
