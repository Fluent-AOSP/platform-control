diff --git a/ui/build/rbe.go b/ui/build/rbe.go
index b3d95c4532..1c237f6bdf 100644
--- a/ui/build/rbe.go
+++ b/ui/build/rbe.go
@@ -182,6 +182,22 @@ def init(ctx):
     return main.generate(ctx, vars, imports)
 `))
 
+func relativeToSisoExecRoot(path string) (string, error) {
+	execRoot, err := os.Getwd()
+	if err != nil {
+		return "", fmt.Errorf("get Siso execution root: %w", err)
+	}
+	absPath, err := filepath.Abs(path)
+	if err != nil {
+		return "", fmt.Errorf("make Siso config path absolute: %w", err)
+	}
+	relPath, err := filepath.Rel(execRoot, absPath)
+	if err != nil {
+		return "", fmt.Errorf("make Siso config path relative to %q: %w", execRoot, err)
+	}
+	return relPath, nil
+}
+
 func createSisoConfigDir(ctx Context, config Config, value string) string {
 	// We need to fabricate a working directory.
 	confDir := filepath.Join(config.OutDir(), "siso_config")
@@ -190,7 +206,11 @@ func createSisoConfigDir(ctx Context, config Config, value string) string {
 		if err != nil {
 			ctx.Fatalf("${SISO_CONFIG_DIR}/main.star is missing: %w", err)
 		}
-		return value
+		relDir, err := relativeToSisoExecRoot(confDir)
+		if err != nil {
+			ctx.Fatalf("Could not make Siso config path exec-root-relative: %v", err)
+		}
+		return relDir
 	}
 	templateConfig := struct {
 		Config       *Config
@@ -210,7 +230,11 @@ func createSisoConfigDir(ctx Context, config Config, value string) string {
 	if err := os.WriteFile(confFile, sb.Bytes(), 0666); err != nil {
 		ctx.Fatalf("Failed to write siso config to %q: %w", confFile, err)
 	}
-	return confDir
+	relDir, err := relativeToSisoExecRoot(confDir)
+	if err != nil {
+		ctx.Fatalf("Could not make Siso config path exec-root-relative: %v", err)
+	}
+	return relDir
 }
 
