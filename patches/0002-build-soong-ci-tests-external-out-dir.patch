Subject: [PATCH] Handle external output paths in CI test packages

Change-Id: I7c11a1bdbe79ddbfde0a17348a172fff1266e8d9
---
 ci_tests/ci_test_package_zip.go      | 12 ++++-
 ci_tests/ci_test_package_zip_test.go | 71 ++++++++++++++++++++++++++++
 2 files changed, 81 insertions(+), 2 deletions(-)
 create mode 100644 ci_tests/ci_test_package_zip_test.go

diff --git a/ci_tests/ci_test_package_zip.go b/ci_tests/ci_test_package_zip.go
index bccfe6569b..8a379b2c15 100644
--- a/ci_tests/ci_test_package_zip.go
+++ b/ci_tests/ci_test_package_zip.go
@@ -298,8 +298,8 @@ func extendBuilderCommand(ctx android.ModuleContext, m android.ModuleProxy, buil
 			continue
 		}
 
-		f := strings.TrimPrefix(installedFile.String(), productOut+"/")
-		if strings.HasPrefix(f, "out") {
+		f, inProductOut := pathRelativeToProductOut(productOut, installedFile.String())
+		if !inProductOut {
 			continue
 		}
 		if strings.HasPrefix(f, "system/") {
@@ -326,6 +326,14 @@ func extendBuilderCommand(ctx android.ModuleContext, m android.ModuleProxy, buil
 	}
 }
 
+func pathRelativeToProductOut(productOut, installedFile string) (string, bool) {
+	rel, err := filepath.Rel(productOut, installedFile)
+	if err != nil || filepath.IsAbs(rel) || rel == ".." || strings.HasPrefix(rel, ".."+string(filepath.Separator)) {
+		return "", false
+	}
+	return rel, true
+}
+
 func removeFileExtension(filename string) string {
 	return strings.TrimSuffix(filename, filepath.Ext(filename))
 }
diff --git a/ci_tests/ci_test_package_zip_test.go b/ci_tests/ci_test_package_zip_test.go
new file mode 100644
index 0000000000..fcff864017
