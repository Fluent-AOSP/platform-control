+package ci_tests
+
+import (
+	"path/filepath"
+	"testing"
+)
+
+func TestPathRelativeToProductOut(t *testing.T) {
+	absoluteProductOut := filepath.Join(t.TempDir(), "target", "product", "device")
+	tests := []struct {
+		name          string
+		productOut    string
+		installedFile string
+		want          string
+		wantInside    bool
+	}{
+		{
+			name:          "relative product file",
+			productOut:    filepath.Join("out", "target", "product", "device"),
+			installedFile: filepath.Join("out", "target", "product", "device", "system", "testcases", "test.apk"),
+			want:          filepath.Join("system", "testcases", "test.apk"),
+			wantInside:    true,
+		},
+		{
+			name:          "relative host file",
+			productOut:    filepath.Join("out", "target", "product", "device"),
+			installedFile: filepath.Join("out", "host", "linux-x86", "framework", "host.jar"),
+		},
+		{
+			name:          "absolute product file",
+			productOut:    absoluteProductOut,
+			installedFile: filepath.Join(absoluteProductOut, "system", "testcases", "test.apk"),
+			want:          filepath.Join("system", "testcases", "test.apk"),
+			wantInside:    true,
+		},
+		{
+			name:          "absolute external host file",
+			productOut:    absoluteProductOut,
+			installedFile: filepath.Join(filepath.Dir(filepath.Dir(filepath.Dir(absoluteProductOut))), "host", "linux-x86", "framework", "host.jar"),
+		},
+		{
+			name:          "product sibling",
+			productOut:    absoluteProductOut,
+			installedFile: filepath.Join(absoluteProductOut+"-other", "system", "test.apk"),
+		},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			got, gotInside := pathRelativeToProductOut(tt.productOut, tt.installedFile)
+			if gotInside != tt.wantInside || got != tt.want {
+				t.Fatalf("pathRelativeToProductOut(%q, %q) = (%q, %t), want (%q, %t)",
+					tt.productOut, tt.installedFile, got, gotInside, tt.want, tt.wantInside)
+			}
+		})
+	}
+}
